#version 430 core
layout(local_size_x = 64) in;

struct BondInput {
	vec4 start;
	vec4 finish;
	vec4 colorA;
	vec4 colorB;
	float radius;
	float pad0;
	float pad1;
	float pad2;
};

struct BondOutput {
	mat4 transform;
	vec4 colorA;
	vec4 colorB;
};

layout(std430, binding = 0) readonly buffer BondIn {
	BondInput bonds[];
} uInput;
layout(std430, binding = 1) writeonly buffer BondOut {
	BondOutput outputs[];
} uOutput;
uniform int u_BondCount;

void main()
{
	uint index = gl_GlobalInvocationID.x;
	if (index >= uint(u_BondCount))
		return;

	BondInput b = uInput.bonds[index];
	vec3 fullDir = b.finish.xyz - b.start.xyz;
	float fullLen = max(length(fullDir), 0.0001);
	vec3 zAxis = fullDir / fullLen;

	float shrinkA = min(b.start.w, fullLen * 0.45);
	float shrinkB = min(b.finish.w, fullLen * 0.45);
	float newLen = max(fullLen - shrinkA - shrinkB, 0.001);
	vec3 newStart = b.start.xyz + zAxis * shrinkA;

	vec3 up = vec3(0.0, 1.0, 0.0);
	if (abs(dot(zAxis, up)) > 0.97)
		up = vec3(1.0, 0.0, 0.0);
	vec3 xAxis = normalize(cross(up, zAxis));
	vec3 yAxis = normalize(cross(zAxis, xAxis));

	uOutput.outputs[index].transform = mat4(
		vec4(xAxis * b.radius, 0.0),
		vec4(yAxis * b.radius, 0.0),
		vec4(zAxis * newLen, 0.0),
		vec4(newStart, 1.0));
	uOutput.outputs[index].colorA = b.colorA;
	uOutput.outputs[index].colorB = b.colorB;
}
