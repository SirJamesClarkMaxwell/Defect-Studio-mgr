#version 430 core
layout(local_size_x = 64) in;

// GPU port of Renderer/Scene/IsosurfaceMesher.cpp - same marching-tetrahedra algorithm (6-tet
// cube decomposition), kept structurally identical so the two are easy to compare/keep in sync.
// One invocation per cube cell; dispatched once per lobe sign (see u_LobeSign) with the same
// output buffer/counter across both dispatches (call site does the memory barrier between them).
//
// Normals are the interpolated density-gradient at each vertex (central differences on the grid,
// transformed into world space via the cell Jacobian), not the flat per-triangle face normal -
// this is what makes a coarse WAVECAR grid still look like a smooth lobe instead of visible facets;
// see IsosurfaceMesher.cpp's flat cross-product normal for the (deliberately simpler, non-rendered
// reference) alternative.

layout(std430, binding = 0) readonly buffer GridBuffer
{
	float values[];
} uGrid;

struct OutVertex
{
	vec4 position;   // xyz used, w unused (std430 vec3-after-vec3 padding avoidance)
	vec4 normalSign; // xyz = normal, w = lobe sign
};

layout(std430, binding = 1) buffer VertexOut
{
	OutVertex vertices[];
} uOutput;

layout(std430, binding = 2) buffer CounterBuffer
{
	uint count;
} uCounter;

uniform ivec3 u_Dimensions;
uniform mat3 u_Cell;
uniform float u_IsoValue;
uniform float u_LobeSign;
uniform uint u_MaxVertices;

const ivec3 kCornerOffsets[8] = ivec3[8](
	ivec3(0, 0, 0), ivec3(1, 0, 0), ivec3(1, 1, 0), ivec3(0, 1, 0),
	ivec3(0, 0, 1), ivec3(1, 0, 1), ivec3(1, 1, 1), ivec3(0, 1, 1));

const int kTetrahedra[6][4] = int[6][4](
	int[4](0, 1, 2, 6), int[4](0, 2, 3, 6), int[4](0, 3, 7, 6),
	int[4](0, 7, 4, 6), int[4](0, 4, 5, 6), int[4](0, 5, 1, 6));

int GridIndex(ivec3 p)
{
	return p.x * u_Dimensions.y * u_Dimensions.z + p.y * u_Dimensions.z + p.z;
}

vec3 CellPosition(ivec3 p)
{
	vec3 fractional = vec3(p) / vec3(u_Dimensions);
	return u_Cell[0] * fractional.x + u_Cell[1] * fractional.y + u_Cell[2] * fractional.z;
}

float SampleGrid(ivec3 p)
{
	p = clamp(p, ivec3(0), u_Dimensions - ivec3(1));
	return uGrid.values[GridIndex(p)];
}

// Central-difference gradient in grid-index space, transformed to world space by `gradientToWorld`
// (see main() - the inverse-transpose of the cell Jacobian, correct for non-orthogonal cells too).
vec3 GradientAt(ivec3 p, mat3 gradientToWorld)
{
	vec3 gridGradient = vec3(
		SampleGrid(p + ivec3(1, 0, 0)) - SampleGrid(p - ivec3(1, 0, 0)),
		SampleGrid(p + ivec3(0, 1, 0)) - SampleGrid(p - ivec3(0, 1, 0)),
		SampleGrid(p + ivec3(0, 0, 1)) - SampleGrid(p - ivec3(0, 0, 1)));
	return gradientToWorld * gridGradient;
}

struct EdgePoint
{
	vec3 position;
	vec3 normal;
};

EdgePoint ComputeEdgePoint(
	float iso, vec3 posA, float valA, vec3 gradA, vec3 posB, float valB, vec3 gradB)
{
	float denominator = valB - valA;
	float t = abs(denominator) > 1e-12 ? (iso - valA) / denominator : 0.5;
	t = clamp(t, 0.0, 1.0);
	EdgePoint result;
	result.position = mix(posA, posB, t);
	// Density increases toward the lobe's interior, so -gradient points outward - same convention
	// the flat cross-product normal ends up with via the winding flips below.
	vec3 mixedGradient = mix(gradA, gradB, t);
	float gradientLength = length(mixedGradient);
	result.normal = gradientLength > 1e-12 ? -mixedGradient / gradientLength : vec3(0.0, 1.0, 0.0);
	return result;
}

void EmitTriangle(EdgePoint p0, EdgePoint p1, EdgePoint p2, float sign_)
{
	uint base = atomicAdd(uCounter.count, 3u);
	if (base + 3u > u_MaxVertices)
		return;

	uOutput.vertices[base + 0u] = OutVertex(vec4(p0.position, 1.0), vec4(p0.normal, sign_));
	uOutput.vertices[base + 1u] = OutVertex(vec4(p1.position, 1.0), vec4(p1.normal, sign_));
	uOutput.vertices[base + 2u] = OutVertex(vec4(p2.position, 1.0), vec4(p2.normal, sign_));
}

// Mirrors PolygoniseTetrahedron in IsosurfaceMesher.cpp exactly (same case split, same edge
// choices, same winding rules) - see that file for the reasoning behind each branch.
void Polygonise(vec3 pos[4], float val[4], vec3 grad[4], float iso, float sign_)
{
	int inMask = 0;
	for (int v = 0; v < 4; ++v)
		if (val[v] >= iso)
			inMask |= (1 << v);

	if (inMask == 0 || inMask == 0xF)
		return;

	int popCount = bitCount(inMask);

	if (popCount == 1 || popCount == 3)
	{
		bool singletonIsIn = popCount == 1;
		int singletonMask = singletonIsIn ? inMask : (~inMask & 0xF);
		int singleton = 0;
		while (((singletonMask >> singleton) & 1) == 0)
			++singleton;

		int others[3];
		int cursor = 0;
		for (int v = 0; v < 4; ++v)
			if (v != singleton)
				others[cursor++] = v;

		EdgePoint p0 = ComputeEdgePoint(
			iso, pos[singleton], val[singleton], grad[singleton], pos[others[0]], val[others[0]], grad[others[0]]);
		EdgePoint p1 = ComputeEdgePoint(
			iso, pos[singleton], val[singleton], grad[singleton], pos[others[1]], val[others[1]], grad[others[1]]);
		EdgePoint p2 = ComputeEdgePoint(
			iso, pos[singleton], val[singleton], grad[singleton], pos[others[2]], val[others[2]], grad[others[2]]);

		if (singletonIsIn)
			EmitTriangle(p0, p1, p2, sign_);
		else
			EmitTriangle(p0, p2, p1, sign_);
	}
	else // popCount == 2
	{
		int insideVertices[2];
		int outsideVertices[2];
		int insideCursor = 0;
		int outsideCursor = 0;
		for (int v = 0; v < 4; ++v)
		{
			if (((inMask >> v) & 1) != 0)
				insideVertices[insideCursor++] = v;
			else
				outsideVertices[outsideCursor++] = v;
		}

		int a = insideVertices[0];
		int b = insideVertices[1];
		int c = outsideVertices[0];
		int d = outsideVertices[1];

		EdgePoint pac = ComputeEdgePoint(iso, pos[a], val[a], grad[a], pos[c], val[c], grad[c]);
		EdgePoint pad = ComputeEdgePoint(iso, pos[a], val[a], grad[a], pos[d], val[d], grad[d]);
		EdgePoint pbd = ComputeEdgePoint(iso, pos[b], val[b], grad[b], pos[d], val[d], grad[d]);
		EdgePoint pbc = ComputeEdgePoint(iso, pos[b], val[b], grad[b], pos[c], val[c], grad[c]);

		EmitTriangle(pac, pad, pbd, sign_);
		EmitTriangle(pac, pbd, pbc, sign_);
	}
}

void main()
{
	int cellsX = u_Dimensions.x - 1;
	int cellsY = u_Dimensions.y - 1;
	int cellsZ = u_Dimensions.z - 1;
	int totalCells = cellsX * cellsY * cellsZ;

	int linear = int(gl_GlobalInvocationID.x);
	if (linear >= totalCells)
		return;

	int i = linear / (cellsY * cellsZ);
	int remainder = linear % (cellsY * cellsZ);
	int j = remainder / cellsZ;
	int k = remainder % cellsZ;

	// d(position)/d(gridIndex) per axis - constant over the whole grid, so the gradient transform
	// below only needs computing once per invocation, not once per corner.
	mat3 jacobian = mat3(
		u_Cell[0] / float(u_Dimensions.x), u_Cell[1] / float(u_Dimensions.y), u_Cell[2] / float(u_Dimensions.z));
	mat3 gradientToWorld = transpose(inverse(jacobian));

	vec3 cornerPos[8];
	float cornerRaw[8];
	vec3 cornerGrad[8];
	for (int c = 0; c < 8; ++c)
	{
		ivec3 offset = kCornerOffsets[c] + ivec3(i, j, k);
		cornerPos[c] = CellPosition(offset);
		cornerRaw[c] = uGrid.values[GridIndex(offset)];
		cornerGrad[c] = GradientAt(offset, gradientToWorld);
	}

	for (int t = 0; t < 6; ++t)
	{
		vec3 pos[4];
		float val[4];
		vec3 grad[4];
		for (int v = 0; v < 4; ++v)
		{
			int idx = kTetrahedra[t][v];
			pos[v] = cornerPos[idx];
			val[v] = u_LobeSign * cornerRaw[idx];
			// Gradient of (sign * raw) is sign * gradient(raw) - the sign flip for the negative
			// lobe also flips which way is "outward", which is correct: it mirrors the winding
			// flip PolygoniseTetrahedron already does for that lobe.
			grad[v] = u_LobeSign * cornerGrad[idx];
		}
		Polygonise(pos, val, grad, u_IsoValue, u_LobeSign);
	}
}
