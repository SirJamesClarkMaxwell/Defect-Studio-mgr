#version 430 core
layout(local_size_x = 64) in;

// GPU port of Renderer/Scene/IsosurfaceMesher.cpp - same marching-tetrahedra algorithm (6-tet
// cube decomposition), kept structurally identical so the two are easy to compare/keep in sync.
// One invocation per cube cell; dispatched once per lobe sign (see u_LobeSign) with the same
// output buffer/counter across both dispatches (call site does the memory barrier between them).

layout(std430, binding = 0) readonly buffer GridBuffer
{
	float values[];
} uGrid;

struct OutVertex
{
	vec4 position;   // xyz used, w unused (std430 vec3-after-vec3 padding avoidance)
	vec4 normalSign; // xyz = normal, w = lobe sign
};

layout(std430, binding = 1) buffer VertexOut
{
	OutVertex vertices[];
} uOutput;

layout(std430, binding = 2) buffer CounterBuffer
{
	uint count;
} uCounter;

uniform ivec3 u_Dimensions;
uniform mat3 u_Cell;
uniform float u_IsoValue;
uniform float u_LobeSign;
uniform uint u_MaxVertices;

const ivec3 kCornerOffsets[8] = ivec3[8](
	ivec3(0, 0, 0), ivec3(1, 0, 0), ivec3(1, 1, 0), ivec3(0, 1, 0),
	ivec3(0, 0, 1), ivec3(1, 0, 1), ivec3(1, 1, 1), ivec3(0, 1, 1));

const int kTetrahedra[6][4] = int[6][4](
	int[4](0, 1, 2, 6), int[4](0, 2, 3, 6), int[4](0, 3, 7, 6),
	int[4](0, 7, 4, 6), int[4](0, 4, 5, 6), int[4](0, 5, 1, 6));

int GridIndex(ivec3 p)
{
	return p.x * u_Dimensions.y * u_Dimensions.z + p.y * u_Dimensions.z + p.z;
}

vec3 CellPosition(ivec3 p)
{
	vec3 fractional = vec3(p) / vec3(u_Dimensions);
	return u_Cell[0] * fractional.x + u_Cell[1] * fractional.y + u_Cell[2] * fractional.z;
}

vec3 EdgeCrossing(float iso, vec3 posA, float valA, vec3 posB, float valB)
{
	float denominator = valB - valA;
	float t = abs(denominator) > 1e-12 ? (iso - valA) / denominator : 0.5;
	return mix(posA, posB, clamp(t, 0.0, 1.0));
}

void EmitTriangle(vec3 p0, vec3 p1, vec3 p2, float sign_)
{
	vec3 crossProduct = cross(p1 - p0, p2 - p0);
	float crossLength = length(crossProduct);
	vec3 normal = crossLength > 1e-12 ? crossProduct / crossLength : vec3(0.0, 1.0, 0.0);

	uint base = atomicAdd(uCounter.count, 3u);
	if (base + 3u > u_MaxVertices)
		return;

	uOutput.vertices[base + 0u] = OutVertex(vec4(p0, 1.0), vec4(normal, sign_));
	uOutput.vertices[base + 1u] = OutVertex(vec4(p1, 1.0), vec4(normal, sign_));
	uOutput.vertices[base + 2u] = OutVertex(vec4(p2, 1.0), vec4(normal, sign_));
}

// Mirrors PolygoniseTetrahedron in IsosurfaceMesher.cpp exactly (same case split, same edge
// choices, same winding rules) - see that file for the reasoning behind each branch.
void Polygonise(vec3 pos[4], float val[4], float iso, float sign_)
{
	int inMask = 0;
	for (int v = 0; v < 4; ++v)
		if (val[v] >= iso)
			inMask |= (1 << v);

	if (inMask == 0 || inMask == 0xF)
		return;

	int popCount = bitCount(inMask);

	if (popCount == 1 || popCount == 3)
	{
		bool singletonIsIn = popCount == 1;
		int singletonMask = singletonIsIn ? inMask : (~inMask & 0xF);
		int singleton = 0;
		while (((singletonMask >> singleton) & 1) == 0)
			++singleton;

		int others[3];
		int cursor = 0;
		for (int v = 0; v < 4; ++v)
			if (v != singleton)
				others[cursor++] = v;

		vec3 p0 = EdgeCrossing(iso, pos[singleton], val[singleton], pos[others[0]], val[others[0]]);
		vec3 p1 = EdgeCrossing(iso, pos[singleton], val[singleton], pos[others[1]], val[others[1]]);
		vec3 p2 = EdgeCrossing(iso, pos[singleton], val[singleton], pos[others[2]], val[others[2]]);

		if (singletonIsIn)
			EmitTriangle(p0, p1, p2, sign_);
		else
			EmitTriangle(p0, p2, p1, sign_);
	}
	else // popCount == 2
	{
		int insideVertices[2];
		int outsideVertices[2];
		int insideCursor = 0;
		int outsideCursor = 0;
		for (int v = 0; v < 4; ++v)
		{
			if (((inMask >> v) & 1) != 0)
				insideVertices[insideCursor++] = v;
			else
				outsideVertices[outsideCursor++] = v;
		}

		int a = insideVertices[0];
		int b = insideVertices[1];
		int c = outsideVertices[0];
		int d = outsideVertices[1];

		vec3 pac = EdgeCrossing(iso, pos[a], val[a], pos[c], val[c]);
		vec3 pad = EdgeCrossing(iso, pos[a], val[a], pos[d], val[d]);
		vec3 pbd = EdgeCrossing(iso, pos[b], val[b], pos[d], val[d]);
		vec3 pbc = EdgeCrossing(iso, pos[b], val[b], pos[c], val[c]);

		EmitTriangle(pac, pad, pbd, sign_);
		EmitTriangle(pac, pbd, pbc, sign_);
	}
}

void main()
{
	int cellsX = u_Dimensions.x - 1;
	int cellsY = u_Dimensions.y - 1;
	int cellsZ = u_Dimensions.z - 1;
	int totalCells = cellsX * cellsY * cellsZ;

	int linear = int(gl_GlobalInvocationID.x);
	if (linear >= totalCells)
		return;

	int i = linear / (cellsY * cellsZ);
	int remainder = linear % (cellsY * cellsZ);
	int j = remainder / cellsZ;
	int k = remainder % cellsZ;

	vec3 cornerPos[8];
	float cornerRaw[8];
	for (int c = 0; c < 8; ++c)
	{
		ivec3 offset = kCornerOffsets[c] + ivec3(i, j, k);
		cornerPos[c] = CellPosition(offset);
		cornerRaw[c] = uGrid.values[GridIndex(offset)];
	}

	for (int t = 0; t < 6; ++t)
	{
		vec3 pos[4];
		float val[4];
		for (int v = 0; v < 4; ++v)
		{
			int idx = kTetrahedra[t][v];
			pos[v] = cornerPos[idx];
			val[v] = u_LobeSign * cornerRaw[idx];
		}
		Polygonise(pos, val, u_IsoValue, u_LobeSign);
	}
}
